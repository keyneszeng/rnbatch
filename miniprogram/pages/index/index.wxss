.kw-placeholder {
    color: #aeb8c6;
}

.demo-link {
    margin-top: 22rpx;
    padding: 14rpx 28rpx;
    border: 2rpx dashed #b9cdf5;
    border-radius: 14rpx;
    color: #2f5bc4;
    font-size: 24rpx;
}

.demo-link:active {
    background: #eef3fe;
}

.member-plan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 0;
    border-top: 2rpx solid #f1f4f9;
}

.member-plan:first-of-type {
    border-top: 0;
}

.member-plan-title {
    color: #22304a;
    font-size: 28rpx;
}

.member-plan-price {
    color: #c8452f;
    font-size: 32rpx;
    font-weight: 600;
}

.member-note {
    margin-top: 8rpx;
    color: #97a2b1;
    font-size: 22rpx;
}

.member-redeem {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 2rpx solid #f1f4f9;
    color: #2f5bc4;
    font-size: 25rpx;
    text-align: center;
}

.member-redeem:active {
    opacity: 0.6;
}

.footer {
    padding: 8rpx 0 24rpx;
    text-align: center;
}

.footer-link {
    color: #97a2b1;
    font-size: 23rpx;
    text-decoration: underline;
}
