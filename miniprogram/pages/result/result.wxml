<view class="page">
    <view class="result-hero">
        <view class="result-mark">✓</view>
        <text class="result-title">已整理 {{renamed}} 个文件</text>
        <text class="result-desc">文件名已经统一，原始文件没有被改动。</text>
        <text class="quota-hint" wx:if="{{quotaHint}}">{{quotaHint}}</text>
    </view>

    <view class="card">
        <view class="card-head">
            <text class="card-title">取回文件</text>
            <text class="card-note">ZIP 保留目录层级</text>
        </view>

        <view class="action" wx:if="{{canShare}}" bindtap="shareToChat">
            <view class="action-main">
                <text class="action-title">转发到微信聊天</text>
                <text class="action-desc">发给自己或同事，手机上就能收</text>
            </view>
            <text class="action-arrow">›</text>
        </view>

        <view class="action" bindtap="saveToDisk">
            <view class="action-main">
                <text class="action-title">保存到电脑</text>
                <text class="action-desc">仅电脑版微信可用</text>
            </view>
            <text class="action-arrow">›</text>
        </view>

        <view class="hint" wx:if="{{demo}}">当前是演示模式，没有真实文件可下载。配置后端地址后即可取回。</view>
    </view>

    <view class="card">
        <view class="card-head">
            <text class="card-title">其他操作</text>
        </view>

        <view class="action" wx:if="{{undoable}}" bindtap="undoRename">
            <view class="action-main">
                <text class="action-title">撤销这次改名</text>
                <text class="action-desc">还原成整理前的文件名</text>
            </view>
            <text class="action-arrow">›</text>
        </view>

        <view class="action" bindtap="restart">
            <view class="action-main">
                <text class="action-title">再整理一批</text>
                <text class="action-desc">清空当前工作区，重新开始</text>
            </view>
            <text class="action-arrow">›</text>
        </view>
    </view>

    <view class="mask" wx:if="{{busyText}}">
        <view class="mask-box">
            <view class="spinner"></view>
            <text class="mask-text">{{busyText}}</text>
        </view>
    </view>
</view>
