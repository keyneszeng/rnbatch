# Prevent credentials, local files, and repository metadata entering the image.
.git
.github
.gitignore
.env
.env.*
**/.env
**/.env.*
!**/.env.example
**/*.secret
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/__pycache__
**/*.pyc
.venv
venv
node_modules
.pytest_cache
.mypy_cache
tests
docs
*.sqlite3
*.db
*.zip
*.tar
*.tgz
